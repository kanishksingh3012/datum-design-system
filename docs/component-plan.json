{
  "status": "draft — awaiting review",
  "conventions": {
    "props": [
      [
        "size",
        "sm · md · lg",
        "md",
        "Controls: 32 / 40 / 48px tall on desktop, +4px on touch screens. Same three names on every component that has a size."
      ],
      [
        "intent",
        "accent · neutral · danger · success · warning · info",
        "accent or neutral",
        "What the color means. Components accept the subset that makes sense (Button: accent, neutral, danger)."
      ],
      [
        "appearance",
        "solid · soft · outline · ghost",
        "solid (or soft)",
        "How much fill. Replaces today's mixed \"variant\" names."
      ],
      [
        "disabled / loading / invalid",
        "boolean",
        "false",
        "Exposed as data-disabled, data-loading, data-invalid for styling; ARIA set automatically."
      ],
      [
        "className, ref, …rest",
        "—",
        "—",
        "Every component forwards its ref, merges className, and spreads remaining props onto the root."
      ]
    ],
    "rules": [
      "Tokens only — no hex values, pixel font sizes, or hardcoded white on accent fills.",
      "Every component is verified in four combinations: orange/navy × light/dark, with automated contrast checks.",
      "Native elements where they are fully stylable (button, input, checkbox, radio); React Aria where behavior is hard (select, menus, dialogs, tabs, tooltips, toasts).",
      "Focus is always visible (border.focus ring); nothing is operable by mouse only.",
      "Motion respects prefers-reduced-motion.",
      "Form controls share one Field pattern: label, helpText, errorText, required, disabled, readOnly."
    ]
  },
