{
  "name": "@datum-design/styles",
  "version": "0.1.0",
  "description": "Design tokens and theme CSS for the Datum design system.",
  "license": "MIT",
  "author": "Kanishk Singh",
  "homepage": "https://github.com/kanishksingh3012/datum-design-system#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanishksingh3012/datum-design-system.git",
    "directory": "packages/styles"
  },
  "bugs": {
    "url": "https://github.com/kanishksingh3012/datum-design-system/issues"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "css",
    "theme",
    "datum"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "files": [
    "tokens/dist",
    "tokens/icons",
    "tokens/primitives.json",
    "tokens/contract.json"
  ],
  "style": "./tokens/dist/minimal.css",
  "exports": {
    "./minimal.css": "./tokens/dist/minimal.css",
    "./icons/*": "./tokens/icons/*",
    "./contract.json": "./tokens/contract.json",
    "./primitives.json": "./tokens/primitives.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node tokens/build.cjs"
  }
}
